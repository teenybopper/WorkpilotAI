# Database
DATABASE_URL=postgresql://workpilot:workpilot_dev@localhost:5432/workpilot

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=workpilot
MINIO_SECRET_KEY=workpilot_dev
