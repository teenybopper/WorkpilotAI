{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkPilot Companion",
  "version": "0.1.0",
  "identifier": "ai.workpilot.companion",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WorkPilot Companion",
        "width": 420,
        "height": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/workpilot-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

